MYSQL_ROOT_PASSWORD=MYSQL_password
MYSQL_DATABASE=lostfound_db

# Nacos 鉴权配置
NACOS_AUTH_ENABLE=true
NACOS_AUTH_IDENTITY_KEY=your_identity_key
NACOS_AUTH_IDENTITY_VALUE=your_identity_value
NACOS_AUTH_TOKEN=your_base64_auth_token_here

# 业务服务注册到 Nacos 时使用的账号
NACOS_SERVER_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=your_nacos_admin_password