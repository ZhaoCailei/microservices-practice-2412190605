git check-ignore .env# ================= 数据库 =================
# root 账号只用于容器初始化/运维，业务服务一律使用下面的独立账号
# 这些值只是本地示例，真实密码请改成自己的，且只写进 .env（.env 已被 .gitignore 忽略）
MYSQL_ROOT_PASSWORD=MYSQL_password
MYSQL_DATABASE=lostfound_db

# 每个服务的独立业务账号（只对各自数据库有权限）
USER_DB_USER=user_app
USER_DB_PASSWORD=user_app_pwd
LOST_DB_USER=lost_app
LOST_DB_PASSWORD=lost_app_pwd
ADMIN_DB_USER=admin_app
ADMIN_DB_PASSWORD=admin_app_pwd

# ================= Nacos 鉴权配置 =================
NACOS_AUTH_ENABLE=true
NACOS_AUTH_IDENTITY_KEY=your_identity_key
NACOS_AUTH_IDENTITY_VALUE=your_identity_value
NACOS_AUTH_TOKEN=your_base64_auth_token_here

# 业务服务注册到 Nacos / 拉取配置时使用的账号
NACOS_SERVER_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=your_nacos_admin_password
# 个人项目使用的分组（不与课堂示例混用）
NACOS_GROUP=ZCL_GROUP
# 配置中心加载哪个命名空间：dev=zcl-dev，test=zcl-test
NACOS_CONFIG_NAMESPACE=zcl-dev

# ================= 应用密钥 =================
# 首次使用请用随机值替换，不要用下面的占位值：
#   echo "JWT_SECRET=$(openssl rand -base64 32)" >> .env
#   echo "GATEWAY_SHARED_SECRET=$(openssl rand -base64 32)" >> .env
JWT_SECRET=replace_with_openssl_rand_base64_32
GATEWAY_SHARED_SECRET=replace_with_openssl_rand_base64_32
